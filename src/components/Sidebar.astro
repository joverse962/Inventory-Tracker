---
const currentPath = Astro.url.pathname;
---
<aside class="w-64 bg-gray-800 text-white p-4 flex flex-col gap-2">
  <div class="mb-6 flex flex-col items-center">
    <img src="/images/CM.png" alt="CM Logo" class="h-10 w-auto mb-2" />
    <!-- <h2 class="text-2xl font-bold">Menu</h2> -->
  </div>
  
  <a 
    href="/" 
    class={`hover:bg-gray-700 p-3 rounded transition flex items-center gap-2 ${currentPath === '/' ? 'bg-gray-700' : ''}`}
  >
    <span>🏠</span>
    <span>Dashboard</span>
  </a>
  
  <a 
    href="/add-item" 
    class={`hover:bg-gray-700 p-3 rounded transition flex items-center gap-2 ${currentPath === '/add-item' ? 'bg-gray-700' : ''}`}
  >
    <span>➕</span>
    <span>Add Item</span>
  </a>
  
  <a 
    href="/profile" 
    class={`hover:bg-gray-700 p-3 rounded transition flex items-center gap-2 ${currentPath === '/profile' ? 'bg-gray-700' : ''}`}
  >
    <span>👤</span>
    <span>Profile</span>
  </a>

  <a 
    id="adminLink"
    href="/admin" 
    class={`hover:bg-gray-700 p-3 rounded transition flex items-center gap-2 ${currentPath === '/admin' ? 'bg-gray-700' : ''}`}
    style="display: none;"
  >
    <span>🛠️</span>
    <span>Admin Dashboard</span>
  </a>
  
  <hr class="my-4 border-gray-600" />
  
  <div class="mt-auto">
    <p class="text-xs text-gray-400">v1.0.0</p>
  </div>
</aside>

<script>
  if (typeof window !== 'undefined') {
    const userRaw = localStorage.getItem('user');
    if (userRaw) {
      try {
        const user = JSON.parse(userRaw);
        if (user?.role === 'admin') {
          const adminLink = document.getElementById('adminLink');
          if (adminLink) {
            adminLink.style.display = 'flex';
          }
        }
      } catch (err) {
        console.warn('Failed to parse stored user for admin link:', err);
      }
    }
  }
</script>
