---
---
<nav class="bg-white shadow px-4 py-3 sm:p-4 flex justify-between items-center gap-3">
  <div class="flex items-center min-w-0 gap-2">
    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-gray-700 hover:bg-gray-50"
      aria-label="Open menu"
      @click="sidebarOpen = true"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <img src="/images/CM-icon.png" alt="CM Logo" class="h-8 w-auto" />
    <h1 class="font-bold text-lg sm:text-xl text-[#4B0082] truncate">Inventory Tracker</h1>
  </div>
  <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
    <a
      href="/profile"
      class="px-3 py-2 sm:px-4 bg-[#4B0082] text-white rounded hover:bg-violet-950 transition text-sm sm:text-base"
    >
      Profile
    </a>
    <button
      id="navbarLogoutBtn"
      class="px-3 py-2 sm:px-4 bg-red-600 text-white rounded hover:bg-red-700 transition text-sm sm:text-base"
    >
      Logout
    </button>
  </div>
</nav>

<script>
  const logoutBtn = document.getElementById('navbarLogoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/login';
    });
  }
</script>
