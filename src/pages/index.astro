---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard - Inventory Tracker">
  <div class="p-6">
    <!-- Header with User Info -->
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-3xl font-bold text-[#4B0082]">Inventory Dashboard</h1>
        <p id="userWelcome" class="text-gray-600 mt-1">Welcome back!</p>
      </div>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-white p-6 rounded-lg shadow">
        <div class="text-gray-500 text-sm">Total Items</div>
        <div id="totalItems" class="text-3xl font-bold text-gray-900">0</div>
      </div>
      <div class="bg-white p-6 rounded-lg shadow">
        <div class="text-gray-500 text-sm">Available</div>
        <div id="availableItems" class="text-3xl font-bold text-green-600">0</div>
      </div>
      <div class="bg-white p-6 rounded-lg shadow">
        <div class="text-gray-500 text-sm">Borrowed</div>
        <div id="borrowedItems" class="text-3xl font-bold text-yellow-600">0</div>
      </div>
      <div class="bg-white p-6 rounded-lg shadow">
        <div class="text-gray-500 text-sm">Taken</div>
        <div id="usedItems" class="text-3xl font-bold text-blue-600">0</div>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white p-4 rounded-lg shadow mb-6">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <input
          type="text"
          id="searchInput"
          placeholder="Search items..."
          class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
        />
        <select id="availabilityFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          <option value="">All Availability</option>
          <option value="available">Available</option>
          <option value="borrowed">Borrowed</option>
          <option value="taken">Taken</option>
        </select>
        <select id="conditionFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          <option value="">All Conditions</option>
          <option value="good">Good</option>
          <option value="waste">Waste</option>
          <option value="need_repairing">Need Repairing</option>
        </select>
        <select
          id="categoryFilter"
          class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Categories</option>
          <!-- dynamic options injected by script -->
        </select>
        <select
          id="locationFilter"
          class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Locations</option>
          <!-- dynamic options injected by script -->
        </select>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600">Loading items...</p>
    </div>

    <!-- Error State -->
    <div id="errorState" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6"></div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-12">
      <svg class="mx-auto h-24 w-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
      </svg>
      <h3 class="mt-4 text-lg font-medium text-gray-900">No items found</h3>
      <p class="mt-2 text-gray-600">Get started by adding your first inventory item.</p>
      <a href="/add-item" class="mt-4 inline-block bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
        Add Item
      </a>
    </div>

    <!-- Items Grid -->
    <div id="itemsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 min-w-0">
      <!-- Items will be inserted here -->
    </div>
  </div>

  <!-- Quantity Modal -->
  <div id="quantityModal" class="hidden fixed inset-0 bg-black bg-opacity-50 items-center justify-center p-4 z-50">
    <div class="bg-white rounded-lg shadow-2xl max-w-md w-full">
      <div class="p-6">
        <h3 id="quantityModalTitle" class="text-xl font-bold mb-4">Select Quantity</h3>
        <p id="quantityModalMessage" class="text-gray-600 mb-4">How many units would you like to take?</p>
        
        <div class="mb-4">
          <label for="quantityInput" class="block text-sm font-medium text-gray-700 mb-2">
            Quantity (max: <span id="maxQuantity">1</span>)
          </label>
          <input
            type="number"
            id="quantityInput"
            min="1"
            max="1"
            value="1"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>
        
        <div class="flex gap-2">
          <button id="quantityConfirmBtn" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
            Confirm
          </button>
          <button id="quantityCancelBtn" class="flex-1 bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 transition">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Item Modal -->
  <div id="itemModal" class="hidden fixed inset-0 bg-black bg-opacity-50 items-center justify-center p-4 z-50">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto overflow-x-hidden">
      <div class="p-6">
        <div class="flex justify-between items-start mb-4">
          <h2 id="modalTitle" class="text-2xl font-bold text-gray-900"></h2>
          <button id="closeModal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div id="modalContent">
          <!-- Modal content will be inserted here -->
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { checkAuth } from '../lib/middleware';
  import { itemsAPI, getCurrentUser } from '../lib/api';

  // Check authentication
  checkAuth();

  let allItems: any[] = [];
  // keep a master list of all possible categories/locations so filters don't disappear
  let categoriesList: string[] = [];
  let locationsList: string[] = [];

  let currentFilters = {
    search: '',
    availability: '',
    status: '',
    category: '',
    location: '',
  };

  // rebuild select options using the master lists
  function populateFilters() {
    const catSelect = document.getElementById('categoryFilter') as HTMLSelectElement;
    const locSelect = document.getElementById('locationFilter') as HTMLSelectElement;
    if (!catSelect || !locSelect) return;

    const prevCat = catSelect.value;
    const prevLoc = locSelect.value;

    // helper to rebuild options list with a remembered value
    function rebuild(select: HTMLSelectElement, items: string[], placeholder: string, prevValue: string) {
      select.innerHTML = `<option value="">${placeholder}</option>`;
      items.forEach(val => {
        const opt = document.createElement('option');
        opt.value = val;
        opt.textContent = val;
        if (val === prevValue) {
          opt.selected = true;
        }
        select.appendChild(opt);
      });
      // ensure the old value stays if it was empty or not found
      if (prevValue && !items.includes(prevValue)) {
        select.value = prevValue;
      }
    }

    rebuild(catSelect, categoriesList, 'All Categories', prevCat);
    rebuild(locSelect, locationsList, 'All Locations', prevLoc);
  }

  // Get current user and display welcome message
  const user = getCurrentUser();
  const userWelcome = document.getElementById('userWelcome');
  if (userWelcome && user) {
    userWelcome.textContent = `Welcome back, ${user.name}!`;
  }

  // load master lists (unfiltered) once or when items change
  async function refreshOptionLists() {
    try {
      const data = await itemsAPI.getAll() as any;
      const masterItems = data.items || [] as any[];
      const categoryValues = masterItems.map((i: any) => i.category).filter((val: unknown): val is string => typeof val === 'string');
      const locationValues = masterItems.map((i: any) => i.location).filter((val: unknown): val is string => typeof val === 'string');
      categoriesList = Array.from(new Set<string>(categoryValues)).sort();
      locationsList = Array.from(new Set<string>(locationValues)).sort();
      populateFilters();
    } catch (err) {
      console.error('[Dashboard] Failed to refresh option lists', err);
    }
  }

  function applyFilters(items: any[]) {
    return items.filter(item => {
      if (currentFilters.availability) {
        if (currentFilters.availability === 'available' && item.availableQuantity <= 0) return false;
        if (currentFilters.availability === 'borrowed' && item.borrowedQuantity <= 0) return false;
        if (currentFilters.availability === 'taken' && item.takenQuantity <= 0) return false;
      }

      if (currentFilters.status) {
        if (!item.instances?.some((instance: any) => instance.condition === currentFilters.status)) {
          return false;
        }
      }

      return true;
    });
  }

  // Fetch items
  async function fetchItems() {
    const loadingState = document.getElementById('loadingState');
    const errorState = document.getElementById('errorState');
    const emptyState = document.getElementById('emptyState');
    const itemsGrid = document.getElementById('itemsGrid');

    // make sure the master lists are populated at least once
    if (categoriesList.length === 0 && locationsList.length === 0) {
      await refreshOptionLists();
    }

    try {
      loadingState?.classList.remove('hidden');
      errorState?.classList.add('hidden');
      emptyState?.classList.add('hidden');
      itemsGrid?.classList.add('hidden');

      const data = await itemsAPI.getAll(currentFilters) as any;
      allItems = data.items || [];

      // keep our master lists up to date in case new categories/locations appeared
      await refreshOptionLists();

      const filteredItems = applyFilters(allItems);

      console.log('[Dashboard] Fetched items:', allItems.length);
      console.log('[Dashboard] Filtered items:', filteredItems.length);

      // populate category & location selects based on data
      populateFilters();
      if (filteredItems.length > 0) {
        console.log('[Dashboard] First filtered item sample:', {
          name: filteredItems[0].name,
          image: filteredItems[0].image,
          hasImage: !!filteredItems[0].image
        });
      }

      loadingState?.classList.add('hidden');

      if (filteredItems.length === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        itemsGrid?.classList.remove('hidden');
        renderItems(filteredItems);
      }

      updateStatistics(filteredItems);
    } catch (error: any) {
      loadingState?.classList.add('hidden');
      if (errorState) {
        errorState.textContent = error.message || 'Failed to load items';
        errorState.classList.remove('hidden');
      }
    }
  }

  // Render items
  function getConditionSummary(instances: any[] = []) {
    if (!instances || instances.length === 0) return 'No condition info';

    const counts = instances.reduce((acc: any, instance: any) => {
      acc[instance.condition] = (acc[instance.condition] || 0) + 1;
      return acc;
    }, {});

    const parts = [];
    if (counts.good) parts.push(`✨ ${counts.good} good`);
    if (counts.need_repairing) parts.push(`🔧 ${counts.need_repairing} repair`);
    if (counts.waste) parts.push(`🗑️ ${counts.waste} waste`);
    return parts.join(', ');
  }

  function renderItems(itemsToShow: any[] = allItems) {
    const itemsGrid = document.getElementById('itemsGrid');
    if (!itemsGrid) return;

    itemsGrid.innerHTML = itemsToShow.map(item => {
      const availabilityColors = {
        available: 'bg-green-100 text-green-800',
        borrowed: 'bg-yellow-100 text-yellow-800',
        taken: 'bg-blue-100 text-blue-800',
      };

      const availabilityColor = availabilityColors[item.availability as keyof typeof availabilityColors] || 'bg-gray-100 text-gray-800';
      const canUpdateStatus = user && item.instances?.some((instance: any) => (instance.borrowedBy?.id === user.id || instance.takenBy?.id === user.id));
      const conditionSummary = getConditionSummary(item.instances);

      return `
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer item-card min-w-0" data-id="${item.id}">
          ${item.image ? `
            <img src="${item.image}" alt="${item.name}" class="w-full h-48 object-cover" />
          ` : `
            <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
              <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
              </svg>
            </div>
          `}
          <div class="p-4">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-semibold text-gray-900">${item.name}</h3>
              <span class="px-2 py-1 text-xs font-medium rounded-full ${availabilityColor}">
                ${item.availability}
              </span>
            </div>
            <p class="text-sm text-gray-600 mb-2 line-clamp-2 break-words">${item.description}</p>
            <div class="text-xs text-gray-500 min-w-0">
              <div>📍 ${item.location}</div>
              <div>🏷️ ${item.category}</div>
              <div>🧮 ${item.availableQuantity} available / ${item.quantity}</div>
              <div>${conditionSummary}</div>
            </div>
          </div>
        </div>
      `;
    }).join('');

    // Add click handlers
    document.querySelectorAll('.item-card').forEach(card => {
      card.addEventListener('click', () => {
        const itemId = card.getAttribute('data-id');
        const item = allItems.find(i => i.id === itemId);
        if (item) showItemModal(item);
      });
    });
  }

  // Show quantity modal
  let currentQuantityModalCancel: (() => void) | undefined;

  function showQuantityModal(title: string, message: string, maxQuantity: number, onConfirm: (quantity: number) => void, onCancel?: () => void) {
    const modal = document.getElementById('quantityModal');
    const modalTitle = document.getElementById('quantityModalTitle');
    const modalMessage = document.getElementById('quantityModalMessage');
    const maxQuantitySpan = document.getElementById('maxQuantity');
    const quantityInput = document.getElementById('quantityInput') as HTMLInputElement;
    const confirmBtn = document.getElementById('quantityConfirmBtn');
    const cancelBtn = document.getElementById('quantityCancelBtn');

    if (!modal || !modalTitle || !modalMessage || !maxQuantitySpan || !quantityInput || !confirmBtn || !cancelBtn) return;

    // Store the cancel callback
    currentQuantityModalCancel = onCancel;

    modalTitle.textContent = title;
    modalMessage.textContent = message;
    maxQuantitySpan.textContent = maxQuantity.toString();
    quantityInput.max = maxQuantity.toString();
    quantityInput.value = '1';

    const handleConfirm = () => {
      const quantity = Number(quantityInput.value.trim());
      if (!Number.isInteger(quantity) || quantity <= 0 || quantity > maxQuantity) {
        alert(`Please enter a valid quantity between 1 and ${maxQuantity}.`);
        return;
      }
      modal.classList.add('hidden');
      currentQuantityModalCancel = undefined;
      onConfirm(quantity);
    };

    const handleCancel = () => {
      modal.classList.add('hidden');
      if (onCancel) onCancel();
      currentQuantityModalCancel = undefined;
    };

    confirmBtn.onclick = handleConfirm;
    cancelBtn.onclick = handleCancel;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  // Close quantity modal
  document.getElementById('quantityModal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      document.getElementById('quantityModal')?.classList.add('hidden');
      if (currentQuantityModalCancel) {
        currentQuantityModalCancel();
        currentQuantityModalCancel = undefined;
      }
    }
  });

  // Show item modal
  function showItemModal(item: any) {
    const modal = document.getElementById('itemModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalContent = document.getElementById('modalContent');

    if (!modal || !modalTitle || !modalContent) return;

    modalTitle.textContent = item.name;

    const availabilityColors = {
      available: 'bg-green-100 text-green-800',
      borrowed: 'bg-yellow-100 text-yellow-800',
      taken: 'bg-blue-100 text-blue-800',
    };

    const conditionEmojis = {
      good: '✨',
      waste: '🗑️',
      need_repairing: '🔧',
    };

    const availabilityColor = availabilityColors[item.availability as keyof typeof availabilityColors] || 'bg-gray-100 text-gray-800';
    const conditionSummary = getConditionSummary(item.instances);
    const userInstances = item.instances?.filter((instance: any) =>
      (instance.borrowedBy?.id === user?.id || instance.takenBy?.id === user?.id)
    ) || [];
    const otherInstances = item.instances?.filter((instance: any) =>
      (instance.borrowedBy?.id && instance.borrowedBy?.id !== user?.id) ||
      (instance.takenBy?.id && instance.takenBy?.id !== user?.id)
    ) || [];
    const canUpdateStatus = userInstances.length > 0;

    modalContent.innerHTML = `
      ${item.image ? `<img src="${item.image}" alt="${item.name}" class="w-full h-64 object-cover rounded-lg mb-4" />` : ''}
      
      <div class="space-y-4">
        <div class="flex gap-2">
          <span class="px-3 py-1 text-sm font-medium rounded-full ${availabilityColor}">${item.availability}</span>
          <span class="px-3 py-1 text-sm font-medium rounded-full bg-purple-100 text-purple-800">${conditionSummary}</span>
        </div>
        
        <div>
          <h3 class="font-semibold text-gray-700">Description</h3>
          <p class="text-gray-600">${item.description}</p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <h3 class="font-semibold text-gray-700">Category</h3>
            <p class="text-gray-600">${item.category}</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-700">Location</h3>
            <p class="text-gray-600">${item.location}</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-700">Total Quantity</h3>
            <p class="text-gray-600">${item.quantity}</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-700">Available</h3>
            <p class="text-gray-600">${item.availableQuantity}</p>
          </div>
          ${item.components && item.components.length > 0 ? `
          <div>
            <h3 class="font-semibold text-gray-700 mb-2">Components</h3>
            <ul class="space-y-1">
              ${item.components.map((c: any) => `
                <li class="text-gray-600">• ${c.name} (${c.quantity}x)</li>
              `).join('')}
            </ul>
          </div>
        ` : ''}
        
        ${otherInstances.length > 0 ? `
          <div class="border border-gray-200 rounded-lg bg-yellow-50 p-4">
            <h3 class="font-semibold text-gray-800 mb-3">Currently held by another user</h3>
            ${otherInstances.map((instance: any, index: number) => `
              <div class="mb-3 last:mb-0 text-sm text-gray-700">
                <div class="font-medium">${instance.borrowedBy?.name || instance.takenBy?.name || 'Unknown user'}</div>
                <div>${instance.borrowedBy ? 'Borrowed' : 'Taken'} • ${instance.condition || 'unknown'}</div>
                <div class="text-xs text-gray-500">${instance.borrowedBy?.email || instance.takenBy?.email || ''}</div>
              </div>
            `).join('')}
          </div>
        ` : ''}
        ${userInstances.length > 0 ? `
          <div class="border border-gray-200 rounded-lg bg-gray-50 p-4">
            <h3 class="font-semibold text-gray-800 mb-3">Your borrowed/taken unit(s)</h3>
            ${userInstances.map((instance: any, index: number) => `
              <div class="mb-4 last:mb-0">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between w-full min-w-0">
                  <div class="min-w-0">
                    <p class="text-sm text-gray-600 break-words">Unit ${index + 1} — ${instance.availability}</p>
                    <p class="text-sm text-gray-900 break-words">Current: ${conditionEmojis[instance.condition as keyof typeof conditionEmojis] || '✓'} ${instance.condition}</p>
                  </div>
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-end gap-2 w-full sm:w-auto min-w-0">
                    <select class="condition-select flex-1 min-w-0 border border-gray-300 rounded px-3 py-2 bg-white text-sm" data-instance-id="${instance.id}">
                      <option value="good" ${instance.condition === 'good' ? 'selected' : ''}>Good</option>
                      <option value="need_repairing" ${instance.condition === 'need_repairing' ? 'selected' : ''}>Needs Repair</option>
                      <option value="waste" ${instance.condition === 'waste' ? 'selected' : ''}>Waste</option>
                    </select>
                    <button class="condition-update-btn flex-shrink-0 bg-purple-600 text-white px-3 py-2 rounded text-sm" data-instance-id="${instance.id}">
                      Save
                    </button>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        ` : ''}
        
        <div class="flex items-start gap-2 pt-4 flex-wrap">
          ${item.availability === 'available' ? `
            <button class="action-btn w-full sm:w-auto max-w-full bg-blue-600 text-white px-4 py-2 text-sm leading-tight rounded-lg hover:bg-blue-700" data-action="take" data-id="${item.id}">
              Take
            </button>
            <button class="action-btn w-full sm:w-auto max-w-full bg-[#4B0082] text-white px-4 py-2 text-sm leading-tight rounded-lg hover:bg-violet-950" data-action="borrow" data-id="${item.id}">
              Borrow
            </button>
          ` : ''}
          ${item.availability === 'borrowed' && user && item.borrowedBy && String(item.borrowedBy.id) === user.id ? `
            <button class="action-btn w-full sm:w-auto max-w-full bg-green-600 text-white px-4 py-2 text-sm leading-tight rounded-lg hover:bg-green-700" data-action="return" data-id="${item.id}">
              Return
            </button>
          ` : ''}
          ${item.availability === 'taken' && user && item.takenBy && String(item.takenBy.id) === user.id ? `
            <button class="action-btn w-full sm:w-auto max-w-full bg-green-600 text-white px-4 py-2 text-sm leading-tight rounded-lg hover:bg-green-700" data-action="return" data-id="${item.id}">
              Return
            </button>
          ` : ''}
          ${user && item.createdBy && String(item.createdBy.id) === user.id ? `
            <button class="action-btn w-full sm:w-auto max-w-full bg-red-600 text-white px-4 py-2 text-sm leading-tight rounded-lg hover:bg-red-700" data-action="delete" data-id="${item.id}">
              Delete
            </button>
          ` : ''}
        </div>
      </div>
    `;

    // Add action handlers
    modalContent.querySelectorAll('.action-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.target as HTMLButtonElement;
        const action = target.getAttribute('data-action');
        const id = target.getAttribute('data-id');
        
        if (!id) return;
        
        try {
          if (action === 'take' || action === 'borrow') {
            const maxQuantity = item.availableQuantity;
            if (maxQuantity <= 0) {
              alert('No items available to take/borrow.');
              return;
            }

            // Hide the item modal before showing quantity modal
            modal.classList.add('hidden');

            showQuantityModal(
              action === 'take' ? 'Take Items' : 'Borrow Items',
              `How many units would you like to ${action}?`,
              maxQuantity,
              async (quantity: number) => {
                try {
                  if (action === 'take') {
                    await itemsAPI.take(id, quantity);
                  } else {
                    await itemsAPI.borrow(id, quantity);
                  }
                  modal.classList.add('hidden');
                  fetchItems();
                } catch (error: any) {
                  alert(error.message || 'Action failed');
                }
              },
              () => {
                // Show item modal again when quantity modal is cancelled
                modal.classList.remove('hidden');
              }
            );
            return;
          } else if (action === 'return') {
            await itemsAPI.return(id);
          } else if (action === 'delete') {
            if (confirm('Are you sure you want to delete this item?')) {
              await itemsAPI.delete(id);
            } else {
              return;
            }
          }
          
          modal.classList.add('hidden');
          fetchItems();
        } catch (error: any) {
          alert(error.message || 'Action failed');
        }
      });
    });

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    // Add condition update handlers for each instance row
    modalContent.querySelectorAll('.condition-update-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.target as HTMLButtonElement;
        const instanceId = target.getAttribute('data-instance-id');
        if (!instanceId) return;

        const select = modalContent.querySelector(`.condition-select[data-instance-id="${instanceId}"]`) as HTMLSelectElement | null;
        if (!select) return;
        const status = select.value as 'good' | 'need_repairing' | 'waste';

        try {
          await itemsAPI.updateStatus(item.id, instanceId, status);
          alert('Condition updated successfully!');
          modal.classList.add('hidden');
          fetchItems();
        } catch (error: any) {
          alert(error.message || 'Failed to update condition');
        }
      });
    });

    // Add close modal handler
    const closeBtn = document.getElementById('closeModal');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
    }

    // Close modal when clicking outside
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });
  }

  // Close modal
  document.getElementById('closeModal')?.addEventListener('click', () => {
    document.getElementById('itemModal')?.classList.add('hidden');
  });

  document.getElementById('itemModal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      document.getElementById('itemModal')?.classList.add('hidden');
    }
  });

  // Update statistics
  function updateStatistics(itemsToShow: any[] = allItems) {
    const total = itemsToShow.length;
    const available = itemsToShow.filter(i => i.availability === 'available').length;
    const borrowed = itemsToShow.filter(i => i.availability === 'borrowed').length;
    const taken = itemsToShow.filter(i => i.availability === 'taken').length;

    document.getElementById('totalItems')!.textContent = total.toString();
    document.getElementById('availableItems')!.textContent = available.toString();
    document.getElementById('borrowedItems')!.textContent = borrowed.toString();
    document.getElementById('usedItems')!.textContent = taken.toString();
  }

  // Filter handlers
  let filterTimeout: ReturnType<typeof setTimeout>;

  function handleFilterChange() {
    clearTimeout(filterTimeout);
    filterTimeout = setTimeout(() => {
      currentFilters = {
        search: (document.getElementById('searchInput') as HTMLInputElement).value,
        availability: (document.getElementById('availabilityFilter') as HTMLSelectElement).value,
        status: (document.getElementById('conditionFilter') as HTMLSelectElement).value,
        category: (document.getElementById('categoryFilter') as HTMLSelectElement).value,
        location: (document.getElementById('locationFilter') as HTMLSelectElement).value,
      };
      fetchItems();
    }, 300);
  }

  document.getElementById('searchInput')?.addEventListener('input', handleFilterChange);
  document.getElementById('availabilityFilter')?.addEventListener('change', handleFilterChange);
  document.getElementById('conditionFilter')?.addEventListener('change', handleFilterChange);
  document.getElementById('categoryFilter')?.addEventListener('change', handleFilterChange);
  document.getElementById('locationFilter')?.addEventListener('change', handleFilterChange);

  // Initial load
  fetchItems();
</script>
