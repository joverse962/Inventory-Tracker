---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Profile - Inventory Tracker">
  <div class="p-4 sm:p-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-900">👤 My Profile</h1>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-gray-600">Loading profile...</p>
    </div>

    <!-- Error State -->
    <div id="errorState" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6"></div>

    <!-- Profile Content -->
    <div id="profileContent" class="hidden space-y-6">
      <!-- User Info Card -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">User Information</h2>
        <div class="space-y-3">
          <div>
            <span class="text-gray-600 font-medium">Name:</span>
            <span id="userName" class="text-gray-900 ml-2"></span>
          </div>
          <div>
            <span class="text-gray-600 font-medium">Email:</span>
            <span id="userEmail" class="text-gray-900 ml-2"></span>
          </div>
          <div>
            <span class="text-gray-600 font-medium">Role:</span>
            <span id="userRole" class=" ml-2 px-2 py-1 bg-blue-100 text-blue-800 rounded text-sm"></span>
          </div>
        </div>
      </div>

      <!-- Statistics Card -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">My Statistics</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <div class="text-3xl font-bold text-blue-600" id="itemsBorrowed">0</div>
            <div class="text-sm text-gray-600 mt-1">Currently Borrowed</div>
          </div>
          <div class="text-center p-4 bg-purple-50 rounded-lg">
            <div class="text-3xl font-bold text-purple-600" id="itemsTaken">0</div>
            <div class="text-sm text-gray-600 mt-1">Currently Taken</div>
          </div>
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <div class="text-3xl font-bold text-green-600" id="itemsCreated">0</div>
            <div class="text-sm text-gray-600 mt-1">Items Created</div>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <div class="text-3xl font-bold text-orange-600" id="totalUsing">0</div>
            <div class="text-sm text-gray-600 mt-1">Total Using</div>
          </div>
        </div>
      </div>

      <!-- Currently Using Items -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">📦 Currently Using Items</h2>
        
        <div id="emptyUsing" class="hidden text-center py-8 text-gray-500">
          <svg class="mx-auto h-16 w-16 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
          </svg>
          <p>You haven't borrowed or taken any items yet.</p>
        </div>

        <div id="usingItemsList" class="space-y-3">
          <!-- Using items will be listed here -->
        </div>
      </div>

      <!-- Borrow History -->
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">📜 Borrow History</h2>
        
        <div id="emptyHistory" class="hidden text-center py-8 text-gray-500">
          <p>No borrow history available.</p>
        </div>

        <div id="historyList" class="space-y-2">
          <!-- History will be listed here -->
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { checkAuth } from '../lib/middleware';
  import { authAPI, itemsAPI } from '../lib/api';

  // Check authentication
  checkAuth();

  const loadingState = document.getElementById('loadingState');
  const errorState = document.getElementById('errorState');
  const profileContent = document.getElementById('profileContent');

  async function loadProfile() {
    try {
      loadingState?.classList.remove('hidden');
      errorState?.classList.add('hidden');
      profileContent?.classList.add('hidden');

      // Fetch user data
      const userData = await authAPI.getMe() as any;
      const user = userData.user;

      // Fetch all items to calculate statistics
      const itemsData = await itemsAPI.getAll() as any;
      const allItems = itemsData.items || [];

      // Update user info
      const userName = document.getElementById('userName');
      const userEmail = document.getElementById('userEmail');
      const userRole = document.getElementById('userRole');

      if (userName) userName.textContent = user.name;
      if (userEmail) userEmail.textContent = user.email;
      if (userRole) userRole.textContent = user.role.toUpperCase();

      // Calculate statistics and active sessions from history
      const historyData = await itemsAPI.getMyHistory() as any;
      const payload = Array.isArray(historyData)
        ? { history: historyData, borrowSessions: [] }
        : (historyData?.data ?? historyData ?? {});
      const sessions = Array.isArray(payload.borrowSessions) ? payload.borrowSessions : [];
      const history = Array.isArray(payload.history) ? payload.history : [];

      // Aggregate active sessions with quantities
      const activeSessions = new Map<string, any>();
      const eventsAsc = [...history].sort(
        (a: any, b: any) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime()
      );

      for (const event of eventsAsc) {
        const action = String(event.action || '').toLowerCase();
        const itemId = event.itemId;
        if (!itemId) continue;

        const notes = event.notes || '';
        const quantityMatch = notes.match(/(borrowed|taken)\s+(\d+)/) || notes.match(/(\d+)/);
        const quantity = quantityMatch ? parseInt(quantityMatch[quantityMatch.length - 1]) : 1;

        if (action === 'borrow' || action === 'take') {
          const existing = activeSessions.get(itemId);
          if (existing) {
            existing.quantity += quantity;
          } else {
            activeSessions.set(itemId, {
              itemId,
              item: event.item,
              action,
              quantity,
              startDate: event.createdAt,
            });
          }
        } else if (action === 'return') {
          const returnMatch = notes.match(/returned\s+(\d+)/) || notes.match(/(\d+)/);
          const returnQuantity = returnMatch ? parseInt(returnMatch[returnMatch.length - 1]) : 1;
          const existing = activeSessions.get(itemId);
          if (existing) {
            existing.quantity -= returnQuantity;
            if (existing.quantity <= 0) {
              activeSessions.delete(itemId);
            }
          }
        }
      }

      // Get active sessions as array
      const activeSessionList = Array.from(activeSessions.values());

      // Calculate statistics
      const borrowedSessions = activeSessionList.filter(s => s.action === 'borrow');
      const takenSessions = activeSessionList.filter(s => s.action === 'take');
      const createdItems = allItems.filter((item: any) => 
        item.createdById === user.id
      );

      const itemsBorrowed = document.getElementById('itemsBorrowed');
      const itemsTaken = document.getElementById('itemsTaken');
      const itemsCreated = document.getElementById('itemsCreated');
      const totalUsing = document.getElementById('totalUsing');

      if (itemsBorrowed) itemsBorrowed.textContent = borrowedSessions.length.toString();
      if (itemsTaken) itemsTaken.textContent = takenSessions.length.toString();
      if (itemsCreated) itemsCreated.textContent = createdItems.length.toString();
      if (totalUsing) totalUsing.textContent = activeSessionList.length.toString();

      // Display using items (active sessions)
      const usingItems = activeSessionList;
      const usingItemsList = document.getElementById('usingItemsList');
      const emptyUsing = document.getElementById('emptyUsing');

      if (usingItems.length === 0) {
        emptyUsing?.classList.remove('hidden');
        if (usingItemsList) usingItemsList.classList.add('hidden');
      } else {
        emptyUsing?.classList.add('hidden');
        if (usingItemsList) {
          usingItemsList.classList.remove('hidden');
          usingItemsList.innerHTML = usingItems.map((session: any) => {
            const item = session.item;
            const isBorrowed = session.action === 'borrow';
            const actionType = isBorrowed ? 'Borrowed' : 'Taken';
            const actionClass = isBorrowed ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800';
            
            return `
              <div class="p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div class="flex items-start gap-3 min-w-0">
                  ${item?.image ? `
                    <img src="${item.image}" alt="${item?.name || 'Unknown'}" class="w-14 h-14 sm:w-16 sm:h-16 object-cover rounded flex-shrink-0" />
                  ` : `
                    <div class="w-14 h-14 sm:w-16 sm:h-16 bg-gray-200 rounded flex items-center justify-center flex-shrink-0">
                      <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7"></path>
                      </svg>
                    </div>
                  `}
                  <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900 truncate">${item?.name || 'Unknown Item'}</h3>
                    <p class="text-sm text-gray-600 truncate">${item?.category || 'Unknown'} • ${item?.location || 'Unknown'}</p>
                    <p class="text-xs text-gray-500">${actionType}: ${new Date(session.startDate).toLocaleDateString()} (${session.quantity} units)</p>
                    <span class="inline-block mt-1 px-2 py-1 text-xs font-medium rounded-full ${actionClass}">
                      ${actionType}
                    </span>
                  </div>
                  </div>

                  <div class="grid grid-cols-2 sm:flex sm:justify-end gap-2 w-full sm:w-auto">
                    <button
                      class="return-partial-btn w-full bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700 transition text-sm font-medium"
                      data-id="${session.itemId}"
                      data-max="${session.quantity}"
                    >
                      Return Some
                    </button>
                    <button
                      class="return-all-btn w-full bg-green-600 text-white px-3 py-2 rounded-lg hover:bg-green-700 transition text-sm font-medium"
                      data-id="${session.itemId}"
                      data-quantity="${session.quantity}"
                    >
                      Return All
                    </button>
                  </div>
                </div>
              </div>
            `;
          }).join('');

          // Add return button handlers
          document.querySelectorAll('.return-all-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              const itemId = (e.target as HTMLElement).getAttribute('data-id');
              const quantity = Number((e.target as HTMLElement).getAttribute('data-quantity'));
              if (!itemId || !quantity) return;

              try {
                await itemsAPI.return(itemId, quantity);
                window.uiToast?.('Returned.', 'success');
                loadProfile(); // Reload profile
              } catch (error: any) {
                window.uiToast?.(error.message || 'Failed to return item', 'error');
              }
            });
          });

          // Add partial return handlers
          document.querySelectorAll('.return-partial-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              const itemId = (e.target as HTMLElement).getAttribute('data-id');
              if (!itemId) return;

              const item = allItems.find((i: any) => i.id === itemId);
              const userInstances = item?.instances?.filter((instance: any) =>
                instance.borrowedBy?.id === user.id || instance.takenBy?.id === user.id
              ) || [];

              if (!item || userInstances.length === 0) {
                window.uiToast?.('No units found for return.', 'warn');
                return;
              }

              const returnModal = document.createElement('div');
              returnModal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50';
              returnModal.innerHTML = `
                <div class="bg-white rounded-lg shadow-2xl max-w-lg w-full max-h-[80vh] overflow-y-auto">
                  <div class="p-6">
                    <h3 class="text-xl font-bold mb-4">Select units to return</h3>
                    <p class="text-gray-600 mb-4">Choose the exact units you want to return and their current condition.</p>
                    <div class="space-y-3 mb-4">
                      ${userInstances.map((instance: any, index: number) => `
                        <label class="flex items-start gap-3 p-3 border border-gray-200 rounded-lg bg-gray-50">
                          <input type="checkbox" name="returnInstance" value="${instance.id}" checked class="mt-1" />
                          <div>
                            <div class="font-medium text-gray-900">Unit ${index + 1}</div>
                            <div class="text-sm text-gray-600">Condition: ${instance.condition || 'unknown'}</div>
                            <div class="text-sm text-gray-600">${instance.borrowedBy ? 'Borrowed' : 'Taken'} by you</div>
                          </div>
                        </label>
                      `).join('')}
                    </div>
                    <div class="flex gap-2">
                      <button id="returnConfirmBtn" class="flex-1 bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                        Return Selected
                      </button>
                      <button id="returnCancelBtn" class="flex-1 bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 transition">
                        Cancel
                      </button>
                    </div>
                  </div>
                </div>
              `;

              document.body.appendChild(returnModal);

              const confirmBtn = returnModal.querySelector('#returnConfirmBtn') as HTMLButtonElement;
              const cancelBtn = returnModal.querySelector('#returnCancelBtn') as HTMLButtonElement;

              confirmBtn.onclick = async () => {
                const selected = Array.from(returnModal.querySelectorAll('input[name="returnInstance"]:checked')) as HTMLInputElement[];
                const quantity = selected.length;
                if (quantity === 0) {
                  window.uiToast?.('Select at least one unit.', 'warn');
                  return;
                }

                try {
                  await itemsAPI.return(itemId, quantity);
                  window.uiToast?.('Returned selected units.', 'success');
                  returnModal.remove();
                  loadProfile();
                } catch (error: any) {
                  window.uiToast?.(error.message || 'Failed to return item', 'error');
                }
              };

              cancelBtn.onclick = () => {
                returnModal.remove();
              };
            });
          });
        }
      }

      // Display borrow/take sessions with start and return dates
      const historyList = document.getElementById('historyList');
      const emptyHistory = document.getElementById('emptyHistory');

      // Create a map of completed sessions (borrow/take with corresponding returns)
      const completedSessions = new Map<string, any>();
      const allEvents = [...history].sort(
        (a: any, b: any) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime()
      );

      // Group events by item and track sessions
      const itemSessions = new Map<string, any[]>();

      for (const event of allEvents) {
        const itemId = event.itemId;
        if (!itemId) continue;

        if (!itemSessions.has(itemId)) {
          itemSessions.set(itemId, []);
        }
        itemSessions.get(itemId)!.push(event);
      }

      // Process each item's events to create session history
      const historySessions: any[] = [];

      for (const [itemId, events] of itemSessions) {
        const item = events[0]?.item;
        let currentSession: any = null;

        for (const event of events) {
          const action = String(event.action || '').toLowerCase();
          const notes = event.notes || '';
          const quantityMatch = notes.match(/(borrowed|taken|returned)\s+(\d+)/) || notes.match(/(\d+)/);
          const quantity = quantityMatch ? parseInt(quantityMatch[quantityMatch.length - 1]) : 1;

          if (action === 'borrow' || action === 'take') {
            // Start a new session
            if (currentSession) {
              // Previous session wasn't completed, add it as incomplete
              historySessions.push(currentSession);
            }
            currentSession = {
              item: item,
              action: action,
              quantity: quantity || 1,
              startDate: event.createdAt,
              returnDate: null,
              status: 'active'
            };
          } else if (action === 'return' && currentSession) {
            // Complete the current session
            currentSession.returnDate = event.createdAt;
            currentSession.returnQuantity = quantity;
            currentSession.status = 'completed';
            historySessions.push(currentSession);
            currentSession = null;
          }
        }

        // Add any remaining incomplete session
        if (currentSession) {
          historySessions.push(currentSession);
        }
      }

      // Also add any individual return events that don't have matching borrow/take
      for (const event of allEvents) {
        const action = String(event.action || '').toLowerCase();
        if (action === 'return') {
          const itemId = event.itemId;
          const notes = event.notes || '';
          const quantityMatch = notes.match(/returned\s+(\d+)/) || notes.match(/(\d+)/);
          const quantity = quantityMatch ? parseInt(quantityMatch[quantityMatch.length - 1]) : 1;

          // Check if this return is already part of a completed session
          const alreadyIncluded = historySessions.some(session =>
            session.item?.id === itemId &&
            session.returnDate === event.createdAt
          );

          if (!alreadyIncluded) {
            historySessions.push({
              item: event.item,
              action: 'return',
              quantity: quantity,
              startDate: event.createdAt,
              returnDate: null,
              status: 'return-only'
            });
          }
        }
      }

      // Sort history sessions by most recent first
      historySessions.sort((a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime());

      if (historySessions.length === 0) {
        emptyHistory?.classList.remove('hidden');
        if (historyList) {
          historyList.classList.add('hidden');
          historyList.innerHTML = '';
        }
      } else {
        emptyHistory?.classList.add('hidden');
        if (historyList) {
          historyList.classList.remove('hidden');
          historyList.innerHTML = historySessions.map((session: any) => {
            const itemName = session.item?.name || 'Unknown item';
            const action = String(session.action || '').toLowerCase();
            const startDate = session.startDate
              ? new Date(session.startDate).toLocaleString()
              : 'Unknown date';
            const returnDate = session.returnDate
              ? new Date(session.returnDate).toLocaleString()
              : null;

            let actionLabel = '';
            let actionClass = '';
            let dateDisplay = '';

            const displayQuantity = session.quantity || 1;

            if (session.status === 'completed') {
              actionLabel = `${action === 'borrow' ? 'Borrowed' : 'Taken'} (${displayQuantity})`;
              actionClass = action === 'borrow' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800';
              dateDisplay = `Borrowed: ${startDate}${returnDate ? ` | Returned: ${returnDate}` : ''}`;
            } else if (session.status === 'active') {
              actionLabel = `${action === 'borrow' ? 'Borrowed' : 'Taken'} (${displayQuantity})`;
              actionClass = action === 'borrow' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800';
              dateDisplay = `Started: ${startDate} (Not returned yet)`;
            } else if (session.status === 'return-only') {
              actionLabel = `Returned (${displayQuantity})`;
              actionClass = 'bg-green-100 text-green-800';
              dateDisplay = `Returned: ${startDate}`;
            }

            return `
              <div class="p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                <div class="min-w-0">
                  <p class="font-medium text-gray-900 truncate">${itemName}</p>
                  <p class="text-sm text-gray-600">${dateDisplay}</p>
                </div>
                <span class="inline-block mt-2 px-2 py-1 text-xs font-medium rounded-full ${actionClass}">
                  ${actionLabel}
                </span>
              </div>
            `;
          }).join('');
        }
      }

      loadingState?.classList.add('hidden');
      profileContent?.classList.remove('hidden');

    } catch (error: any) {
      loadingState?.classList.add('hidden');
      if (errorState) {
        errorState.textContent = error.message || 'Failed to load profile';
        errorState.classList.remove('hidden');
      }
    }
  }

  // Load profile on page load
  loadProfile();
</script>
